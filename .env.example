# Set ONE of these; the tool picks the provider from whichever key is present
# (order if several: ANTHROPIC, OPENAI, OPENROUTER, GROQ, GEMINI). LLM_PROVIDER overrides that choice.
OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...        # Claude also needs: pip install anthropic
# GROQ_API_KEY=...                     # also set LLM_MODEL
# GEMINI_API_KEY=...                   # also set LLM_MODEL

# Optional
# LLM_PROVIDER=openrouter              # openrouter | openai | anthropic | groq | gemini | ollama | openai-compatible
# LLM_MODEL=qwen/qwen3.8-27b:free      # model id for the chosen provider (default: the provider's default)
# LLM_BASE_URL=http://localhost:8000/v1   # any OpenAI-compatible server (vLLM, LM Studio, a proxy, ...)
# LLM_API_KEY=...                      # key for LLM_BASE_URL, or to override a provider's key variable
# LLM_PRICE_IN=0.42                    # USD per 1M input tokens, for the cost projection of an unlisted model
# LLM_PRICE_OUT=3.00
